# Copy to .env at the repository root. Use a newly generated secret, never commit .env.
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=true
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SQLite is only for local development; production requires PostgreSQL.
CHATBOT_SQLITE=false
# Compose overrides this URL to reach the optional Ollama service.
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Add a Google AI Studio key later to enable the external Gemini connection.
GOOGLE_API_KEY=
# OpenRouter Jev decision model; blank keeps Auto on its safe local fallback.
OPENROUTER_API_KEY=
JEV_ROUTER_URL=https://openrouter.ai/api/alpha/decisions
JEV_ROUTER_MODEL=typesafe/jev-1.13
JEV_ROUTER_TIMEOUT=8
JEV_ROUTER_MIN_CONFIDENCE=0.7
# Used only by the explicit DEBUG-only seed_test_access command.
DJANGO_TEST_USER_PASSWORD=
